# ====================================================
# BANGLADESH POWER & DESCO TELEGRAM BOT CONFIGURATION
# ====================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Public Webhook URL (e.g. https://your-app.onrender.com)
WEBHOOK_URL=http://localhost

# Web Server Port
PORT=10000

# Admin Telegram User ID for /admin analytics dashboard
ADMIN_ID=123456789

# ====================================================
# AI ASSISTANT CONFIGURATION (3-TIER FAILOVER)
# ====================================================

# Google AI Studio Gemini API Key (Primary - 1,000 Free Req/Day)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Secondary - High-Speed LPU Llama-3 70B)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Tertiary - Free Open Models)
# Get key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
